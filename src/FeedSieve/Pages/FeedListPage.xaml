<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:FeedSieve.PageModels"             
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             xmlns:pages="using:FeedSieve.Pages" 
             xmlns:converters="using:FeedSieve.Converters"
             x:Class="FeedSieve.Pages.FeedListPage"
             x:DataType="pageModels:FeedTabViewModel"
             x:Name="OverviewPage">
    <ContentPage.Resources>
        <ResourceDictionary Source="FeedItemTemplates.xaml" />
        <pages:FeedItemTemplateSelector x:Key="FeedItemTemplateSelector"
                                         FeaturedTemplate="{StaticResource FeaturedFeedRowTemplate}"
                                         StandardTemplate="{StaticResource StandardFeedRowTemplate}" />
        <converters:IntGreaterThanZeroConverter x:Key="UnreadVisibleConverter" />
        <converters:IntGreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header: title + unread count + refresh/add-folder actions -->
        <Grid Grid.Row="0" Padding="16,12,12,8" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Label Text="FeedSieve" FontFamily="Inter-SemiBold" FontSize="20"
                       TextColor="{DynamicResource ThemeForeground}" />
                <Label Text="{Binding TotalUnread, StringFormat='{0} unread'}"
                       IsVisible="{Binding TotalUnread, Converter={StaticResource UnreadVisibleConverter}}"
                       FontFamily="JetBrainsMono" FontSize="11"
                       TextColor="{DynamicResource ThemeMutedForeground}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                <ImageButton Command="{Binding RefreshCommand}"
                             Source="refresh.png" WidthRequest="32" HeightRequest="32"
                             BackgroundColor="Transparent" />
                <ImageButton Command="{Binding AddFolderCommand}"
                             Source="folder_plus.png" WidthRequest="32" HeightRequest="32"
                             BackgroundColor="Transparent" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Folder list, pull-to-refresh -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Folders}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="0,48">
                        <Label Text="No folders yet" FontFamily="Inter" FontSize="14"
                               TextColor="{DynamicResource ThemeMutedForeground}"
                               HorizontalOptions="Center" />
                        <Button Text="Add folder" Command="{Binding AddFolderCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource ThemePrimary}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pageModels:FolderViewModel">
                        <toolkit:Expander IsExpanded="{Binding IsExpanded}">
                            <toolkit:Expander.Header>
                                <Grid Padding="16,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}"
                                           FontFamily="Inter-Medium" FontSize="12"
                                           TextTransform="Uppercase"
                                           CharacterSpacing="1.2"
                                           TextColor="{DynamicResource ThemeMutedForeground}"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />

                                    <Border Grid.Column="1" IsVisible="{Binding UnreadCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                            StrokeShape="RoundRectangle 3" Padding="6,1" StrokeThickness="0"
                                            BackgroundColor="{DynamicResource ThemePrimary}" Opacity="0.15">
                                        <Label Text="{Binding UnreadCount}" FontFamily="JetBrainsMono" FontSize="10"
                                               TextColor="{DynamicResource ThemePrimary}" />
                                    </Border>

                                    <ImageButton Grid.Column="2" Source="more_horizontal.png"
                                                 WidthRequest="24" HeightRequest="24"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding ToggleExpandedCommand}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <CollectionView ItemsSource="{Binding Feeds}"
                                            ItemTemplate="{StaticResource FeedItemTemplateSelector}"
                                            Margin="20,0,0,0">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>
                            </CollectionView>
                        </toolkit:Expander>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
