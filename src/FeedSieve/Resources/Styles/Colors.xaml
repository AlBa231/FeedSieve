<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Colors provided by template -->
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="DarkBackground">#17171a</Color>
    <Color x:Key="LightOnDarkBackground">#C3C3C3</Color>
    <Color x:Key="LightBackground">#F2F2F2</Color>
    <Color x:Key="DarkOnLightBackground">#0D0D0D</Color>

    <Color x:Key="LightSecondaryBackground">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryBackground">#222228</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>


    <!-- end colors provided by template -->

    <!-- Light theme -->

    <Color x:Key="Background">#F5F5F7</Color>
    <Color x:Key="Foreground">#111113</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="CardForeground">#111113</Color>
    <Color x:Key="Popover">#FFFFFF</Color>
    <Color x:Key="PopoverForeground">#111113</Color>
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryForeground">#FFFFFF</Color>
    <Color x:Key="Secondary">#EBEBEF</Color>
    <Color x:Key="SecondaryForeground">#111113</Color>
    <Color x:Key="Muted">#EBEBEF</Color>
    <Color x:Key="MutedForeground">#7A7A8A</Color>
    <Color x:Key="Accent">#2563EB</Color>
    <Color x:Key="AccentForeground">#FFFFFF</Color>
    <Color x:Key="Destructive">#DC2626</Color>
    <Color x:Key="DestructiveForeground">#FFFFFF</Color>
    <Color x:Key="Border">#14000000</Color>
    <!-- rgba(0,0,0,0.08) -->

    <!-- Dark theme -->
    <Color x:Key="BackgroundDark">#0D0D0F</Color>
    <Color x:Key="ForegroundDark">#E8E8EC</Color>
    <Color x:Key="CardDark">#141417</Color>
    <Color x:Key="CardForegroundDark">#E8E8EC</Color>
    <Color x:Key="PopoverDark">#1C1C21</Color>
    <Color x:Key="PopoverForegroundDark">#E8E8EC</Color>
    <Color x:Key="PrimaryDark">#4F8EF7</Color>
    <Color x:Key="PrimaryForegroundDark">#FFFFFF</Color>
    <Color x:Key="SecondaryDark">#1C1C21</Color>
    <Color x:Key="SecondaryForegroundDark">#E8E8EC</Color>
    <Color x:Key="MutedDark">#1C1C21</Color>
    <Color x:Key="MutedForegroundDark">#6B6B7A</Color>
    <Color x:Key="AccentDark">#4F8EF7</Color>
    <Color x:Key="AccentForegroundDark">#FFFFFF</Color>
    <Color x:Key="DestructiveDark">#E5464A</Color>
    <Color x:Key="DestructiveForegroundDark">#FFFFFF</Color>
    <Color x:Key="BorderDark">#12FFFFFF</Color>
    <!-- rgba(255,255,255,0.07) -->

    <!-- Tag chip colors (TAG_COLORS in App.tsx) -->
    <Color x:Key="TagAI">#60A5FA</Color>
    <Color x:Key="TagPolicy">#FBBF24</Color>
    <Color x:Key="TagGeopolitics">#FB7185</Color>
    <Color x:Key="TagRust">#FB923C</Color>
    <Color x:Key="TagInfra">#22D3EE</Color>
    <Color x:Key="TagTools">#A78BFA</Color>
    <Color x:Key="TagInterview">#34D399</Color>
    <Color x:Key="TagEssay">#2DD4BF</Color>
    <Color x:Key="TagML">#818CF8</Color>
    <Color x:Key="TagDefault">#7A7A8A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>